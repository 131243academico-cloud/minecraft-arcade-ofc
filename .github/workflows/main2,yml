name: Compilar Jogo da Velha para Linux

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar o projeto
        uses: actions/checkout@v4.2.2

      - name: Instalar Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Instalar Dependências do Sistema (Para Tkinter)
        run: |
          sudo apt-get update
          sudo apt-get install -y python3-tk

      - name: Instalar Nuitka e Dependências do Python
        run: |
          python -m pip install --upgrade pip
          python -m pip install nuitka ordered-set zstandard pytoml

      - name: Verificar arquivo Python
        run: |
          python -m py_compile main.py

      - name: Compilar programa para Linux
        run: |
          python -m nuitka --onefile --enable-plugin=tk-inter --assume-yes-for-downloads --output-dir=dist --output-filename="Programa_do_jogo_da_velha_sem_joy" main.py

      - name: Verificar executável
        run: |
          ls -la dist

      - name: Disponibilizar executável
        uses: actions/upload-artifact@v4
        with:
          name: Jogo-da-Velha-Linux
          path: dist/Programa_do_jogo_da_velha_sem_joy
          if-no-files-found: error
